# 로컬 개발 전용 예시. 실제 비밀 값은 커밋하지 않습니다.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://git_analyze:git_analyze_dev@127.0.0.1:5432/git_analyze
# CLI 수집은 LLM 키 없이 동작합니다.
# 저장소별 자격 증명과 CLI의 LLM 설정 연결은 후속입니다.
# OpenAiAnalysisProvider는 호출자가 키·모델·contextWindowTokens를 명시합니다.

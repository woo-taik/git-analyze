# 로컬 개발 전용 예시. 실제 비밀 값은 커밋하지 않습니다.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://git_analyze:git_analyze_dev@127.0.0.1:5432/git_analyze
# CLI 수집은 LLM 키 없이 동작합니다.
# analyze는 캐시 miss에만 키가 필요합니다. dry-run과 캐시 hit에는 외부 요청이 없습니다.
# 모델·model-epoch·context window는 CLI 옵션으로 명시합니다.
# OPENAI_API_KEY=
